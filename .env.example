# Copy to .env and fill in. Never commit .env.
# NASA Earthdata Login (MODIS LST, NASADEM, ASTER, AppEEARS)  -> https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# api.nasa.gov key (optional)                                   -> https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
# OpenTopography API key (Copernicus GLO-30 / SRTM subsets)      -> https://portal.opentopography.org
OPENTOPO_API_KEY=
# Google Earth Engine cloud project (noncommercial registration) -> https://earthengine.google.com
EE_PROJECT=
# Copernicus Data Space (Sentinel-2)                             -> https://dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=
# Force cache/fixture mode for demos
OFFLINE=0
